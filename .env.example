# Okami no Migiude (女将の右腕) MVP — environment template (contract §15).
# Copy to `.env` and fill in real values; never commit a real `.env`.
# All values below are placeholders, not credentials.

DATA_DIR=.data
PUBLIC_BASE_URL=http://localhost:3000
STAFF_EMAILS=          # comma-separated; enables staff accounts
STAFF_PASSWORD=        # shared initial staff password (never committed)
SMTP_HOST=             # absence of SMTP_HOST selects the local outbox
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Report-ready mail delivery (§9). Default is the LOCAL OUTBOX: .eml files in
# ${DATA_DIR}/mail-outbox — no external mail is sent and nothing leaves the
# machine. The optional live sender stays OFF unless BOTH of the following are
# set; when enabled it takes precedence over SMTP_HOST.
MAIL_LIVE_PROVIDER=
# set to 'resend' to enable the idempotent live sender (REST, no new deps;
# stable Idempotency-Key per message, so retries never double-send)
MAIL_RESEND_API_KEY=
# Resend REST API key — placeholder here; NEVER commit a real key
MAIL_RESEND_BASE_URL=
# default https://api.resend.com; a plain-HTTP override is accepted for
# loopback QA stubs only (anything else is treated as unconfigured)
INTEGRATION_BASE_URL=  # absence disables live mode (demo only)
INTEGRATION_TOKEN=
