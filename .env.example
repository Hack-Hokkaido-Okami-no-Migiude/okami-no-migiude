# Okami no Migiude (女将の右腕) MVP — environment template (contract §15).
# Copy to `.env` and fill in real values; never commit a real `.env`.
# All values below are placeholders, not credentials.

DATA_DIR=.data
PUBLIC_BASE_URL=http://localhost:3000
STAFF_EMAILS=          # comma-separated; enables staff accounts
STAFF_PASSWORD=        # shared initial staff password (never committed)
SMTP_HOST=             # absence of SMTP_HOST selects the local outbox
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Report-ready mail delivery (§9). Default is the LOCAL OUTBOX: .eml files in
# ${DATA_DIR}/mail-outbox — no external mail is sent and nothing leaves the
# machine. The optional live sender stays OFF unless BOTH of the following are
# set; when enabled it takes precedence over SMTP_HOST.
MAIL_LIVE_PROVIDER=
# set to 'resend' to enable the idempotent live sender (REST, no new deps;
# stable Idempotency-Key per message, so retries never double-send)
MAIL_RESEND_API_KEY=
# Resend REST API key — placeholder here; NEVER commit a real key
MAIL_RESEND_BASE_URL=
# default https://api.resend.com; a plain-HTTP override is accepted for
# loopback QA stubs only (anything else is treated as unconfigured)
INTEGRATION_BASE_URL=  # absence disables live mode (demo only)
INTEGRATION_TOKEN=

# ── Voice chat (owner-facing AI voice agent; conversation only, no reports) ──
# Voice chat stays OFF until ALL five values below are set. When configured,
# GET /api/voice/config reports available=true and the dashboard entry works.
ELEVENLABS_API_KEY=    # ElevenLabs API key — placeholder here; NEVER commit a real key
ELEVENLABS_AGENT_ID=   # agent_… ID of the Shima Enaga voice agent
ELEVENLABS_WEBHOOK_SECRET=
# shared secret that verifies the signed post-call webhook (ElevenLabs-Signature)
RESEARCH_TOOL_SECRET=
# Bearer secret the ElevenLabs agent sends to /api/voice/elevenlabs/start-research
LINKUP_API_KEY=        # Linkup API key — placeholder here; NEVER commit a real key
# Optional base-URL overrides for QA stubs only (same rules as
# MAIL_RESEND_BASE_URL: https, or plain HTTP for loopback hosts):
ELEVENLABS_API_BASE_URL=
LINKUP_API_BASE_URL=

# ── Neon (optional one-way copy of records; off when unset) ──
NEON_DATABASE_URL=     # Neon connection string — placeholder here; NEVER commit a real one
NEON_SYNC_INTERVAL_MS= # default 15000
NEON_RETENTION_DAYS=   # transcript delete_after, days after the interview; default 90
NEON_REAL_DATA=        # set to 'true' only for real (non-synthetic) businesses
