# P0 slice environment (copy to .env for local runs; never commit real values)

# Local durable JSON store directory (repo-local, git-ignored, outside public/)
NUXT_DATA_DIR=.data

# Live LLM provider (optional — the fixture demo needs none of these).
# Keep these values private; they are only read server-side.
NUXT_LLM_BASE_URL=
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=

# Recorded-audio transcription provider (optional — pasted transcripts need none
# of these). Keep these values private; they are only read server-side. The key
# is never sent to the browser, logged, or persisted; the raw audio and the
# transcription response are never stored by this app.
#
# Without a key, recorded upload fails closed (503 provider_unconfigured).
# For trusted local testing without credentials, run the bundled stub and point
# the base URL at it (scripts/dev-audio-stub.mjs). The override is refused for
# any non-loopback URL.
NUXT_ELEVENLABS_API_KEY=
NUXT_ELEVENLABS_BASE_URL=
