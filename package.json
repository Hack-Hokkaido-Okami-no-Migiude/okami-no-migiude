{
	"name": "nuxt-template-bootstrap",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "dotenvx run --env NODE_OPTIONS=--enable-source-maps -- nuxt dev",
		"format": "prettier . --write",
		"generate": "nuxt generate",
		"lint": "eslint .",
		"postinstall": "nuxt prepare",
		"preview": "nuxt preview",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"test": "npm run build && node --import tsx --test tests/smoke/p0-slice.test.ts",
		"test:smoke": "node --import tsx --test tests/smoke/p0-slice.test.ts",
		"typecheck": "nuxt typecheck"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.28.2": true
	},
	"dependencies": {
		"@nuxt/eslint": "^1.7.1",
		"@nuxt/fonts": "^1.2.0",
		"@nuxt/icon": "^2.0.0",
		"@nuxtjs/color-mode": "^4.0.0",
		"nuxt": "^4.6.4",
		"sass-embedded": "^1.89.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^2.23.0",
		"@types/node": "^26.6.6",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"subset-font": "^2.9.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vue-tsc": "^3.1.8"
	}
}
